// Exemplo J3 - nivel intermediario: listas, dicionarios, numeros normais, modulos, tarefas
importar "matematica";

var inteiro = 42;
var negativo = -7;
var decimal = 3.14;
var milhar = 1_000_000;
var hex = 0xFF;
var bin = 0b1010;
var oct = 0o17;
escreva("numeros normais: " + inteiro + ", " + decimal + ", " + milhar + ", " + hex + ", " + bin + ", " + oct);

var lista = [1, 2, 3, 4, 5];
escreva("tamanho lista=" + tamanho(lista));
lista = empurrar(lista, 6);
escreva("lista[0]=" + lista[0]);

var pessoa = { nome: "Vessie", versao: 3 };
escreva(pessoa["nome"] + " v" + pessoa["versao"]);

para cada (x em lista) {
  escreva("cada: " + x);
}

tarefa "fundo" {
  escreva("rodando em segundo plano");
}

texto_maiusculo("ola mundo");
